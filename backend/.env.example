# ============================================================
# Skill Assessment Agent — environment variables
# Copy to .env and fill in. Never commit .env.
# ============================================================

# --- LLM provider (need at least one) ---
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=

# Choose which to prefer when both are set
LLM_PROVIDER=openai          # openai | anthropic

# --- Per-node model overrides (optional — defaults are sane) ---
# Cheap structured tasks
PARSER_MODEL=gpt-4o-mini
SCORER_MODEL=gpt-4o-mini
SUPERVISOR_MODEL=gpt-4o-mini
GAP_ANALYZER_MODEL=gpt-4o-mini
# Stronger reasoning tasks
INTERVIEWER_MODEL=gpt-4o
PLAN_GENERATOR_MODEL=gpt-4o

# --- Memory (Mem0) — optional ---
MEM0_ENABLED=false
MEM0_API_KEY=

# --- Observability (LangSmith) — strongly recommended for the demo ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=skill-assessment-agent

# --- App ---
APP_ENV=dev
CORS_ORIGINS=["http://localhost:3000"]

# --- Interview tuning ---
MIN_QUESTIONS_PER_SKILL=2
MAX_QUESTIONS_PER_SKILL=4
IRT_CONFIDENCE_THRESHOLD=0.7

# --- Storage ---
CHROMA_PERSIST_DIR=./chroma_data
SQLITE_CHECKPOINT_PATH=./checkpoints.sqlite
